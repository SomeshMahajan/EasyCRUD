pipeline {
    agent {
        label 'worker'
    }

    tools{
        maven 'mvn'
    }

    stages {
        stage('Checkout'){
            steps {
                git branch: 'main', credentialsId:'github-cred',url:'https://github.com/SomeshMahajan/EasyCRUD.git'
            }
        }

        stage('Build'){
            steps {
                dir('backend'){
                    sh 'mvn clean package'
                }
            }
        }
    }
}